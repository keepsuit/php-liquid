<header class="site-header">
  <a class="site-header__brand" href="/">{{ shop.name }}</a>
  <nav class="site-header__nav" aria-label="Main navigation">
    <ul>
      {%- for link in links %}
      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {%- endfor %}
    </ul>
  </nav>
  <p class="site-header__cart">
    {%- render "snippets.shared.icon", name: "bag" -%}
    {%- if cart.is_empty %}
    <span>Your bag is empty</span>
    {%- else %}
    <span>{{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }} &middot; {{ cart.total_price | money }}</span>
    {%- endif %}
  </p>
</header>
