<header class="site-header">
  <a href="/" class="site-header__brand">{{ shop.name }}</a>
  <nav aria-label="Main navigation">
    <ul>{% for link in links %}
      <li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
    </ul>
  </nav>
  <p class="site-header__cart">{% render "snippets.shared.icon", name: "bag" %} Cart: {{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }} / {{ cart.total_price | fixture_money }}</p>
</header>
