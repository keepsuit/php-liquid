<!doctype html>
<html lang="en">
<head>
  <title>{{ shop.name }} &mdash; {{ page_title }}</title>
  <meta charset="utf-8">
</head>
<body id="page-{{ template }}">
  {% render "snippets.shared.site_header", shop: shop, cart: cart, links: linklists.main-menu.links %}
